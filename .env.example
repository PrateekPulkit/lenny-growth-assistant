# Required for the cloud-provider option. Leave blank to run Ollama-only.
ANTHROPIC_API_KEY=

# Database (Docker Compose defaults work locally)
POSTGRES_DB=lenny_growth
POSTGRES_USER=lenny
POSTGRES_PASSWORD=change-me-before-deployment
DATABASE_URL=postgresql+asyncpg://lenny:change-me-before-deployment@db:5432/lenny_growth

# Models
DEFAULT_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Retrieval and security
EMBEDDING_DIMENSIONS=768
RETRIEVAL_TOP_K=5
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO
